{
  "expo": {
    "name": "Share File App",
    "slug": "share-file-app",
    "version": "1.2.0",
    "owner": "abo0maher007s-team",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "sdkVersion": "51.0.0",
    "splash": {
      "backgroundColor": "#0B0F19",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.abomaher.sharefileapp",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "السماح للتطبيق بالوصول للصور لمشاركتها.",
          "saveToPhotosPermission": "السماح بحفظ الصور المستلمة."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bdb8cd2a-f008-4fe4-900f-465de128d13f"
      }
    }
  }
}
