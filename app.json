{
  "expo": {
    "name": "SHAREit Clone",
    "slug": "shareit-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "يحتاج التطبيق إذن الوصول للمعرض لإرسال واستقبال الصور والفيديوهات.",
          "saveTemplate": "Save to Gallery",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج التطبيق إذن الوصول للكاميرا لمسح رمز QR الخاص بالمستلم."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bdb8cd2a-f008-4fe4-900f-465de128d13f"
      }
    }
  }
}    },
