"expo": {
    "name": "SHAREit Pro",
    "slug": "share-file-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "android": {
      "package": "com.abo0maher007.sharefileapp",
      "versionCode": 4,
      "splash": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CHANGE_WIFI_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow app to access media library",
          "saveTemplate": "Save to Gallery",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow app to access camera to scan QR code"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7184db86-fc09-4c0c-ae40-8032031fdfbb"
      }
    }
  }
